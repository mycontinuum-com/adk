  "scripts": {
    "build": "rm -rf dist && tsup && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/postbuild-dts-aliases.cjs && node scripts/postbuild-cli-cjs-wrapper.cjs && node scripts/verify-package-exports.cjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:postgres": "vitest run src/**/postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "ci": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && node scripts/verify-package-exports.cjs"
  },
