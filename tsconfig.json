{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "ES2023"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "stripInternal": true,
    "jsx": "react",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@anima/adk": [
        "./src/index.ts"
      ],
      "@anima/adk/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-support"
  ]
}
