{
  "name": "adk-bookings-sample",
  "version": "0.0.0",
  "private": true,
  "description": "Reference sample for @animahealth/adk: an agent that proposes a booking, stops for a human, and resumes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ask": "tsx src/cli.ts ask",
    "pending": "tsx src/cli.ts pending",
    "approve": "tsx src/cli.ts approve",
    "deny": "tsx src/cli.ts deny",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@animahealth/adk": "file:..",
    "better-sqlite3": "^12.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
