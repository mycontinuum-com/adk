# `"@animahealth/adk": "file:.."` would otherwise be symlinked, and Node resolves a symlinked
# package's own imports from its real location — so the ADK's optional peers (better-sqlite3) would
# be looked for beside the framework instead of here, and a fresh clone has nothing there.
# install-links copies the package in instead, which is also how `npm i @animahealth/adk` behaves.
install-links=true
